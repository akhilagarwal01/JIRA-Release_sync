# JIRA (Cloud). Create API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# JQL for issues to export (optional; default: updated in last 7 days).
# Multiline values: escape inner double quotes, e.g. \"Release Approved\"
# JIRA_JQL=project = MYPROJ AND status != Done ORDER BY updated DESC

# Google Sheet (from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Worksheet tab name (created automatically if missing). Optional Jenkins String
# parameter GOOGLE_SHEETS_TAB_NAME overrides this; if unset in Jenkins, .env is used.
GOOGLE_SHEETS_TAB_NAME=JIRA_Sheet
# Column range on that tab (A–H). Legacy: JIRA_Sheet!A:H still works if TAB_NAME is unset
GOOGLE_SHEETS_RANGE=A:H

# Latest comment by this display name whose text starts with the prefix → Updated column (date)
# JIRA_RELEASE_COMMENT_AUTHOR=Saathi
# JIRA_RELEASE_COMMENT_PREFIX=Release has been completed  for
# Linked column lists issuelinks of these types only (comma-separated; default Task)
# JIRA_LINKED_TASK_TYPE=Task,Story
# For listed creators only: include release ticket when a linked issue project/key
# contains one of the substrings (e.g. COR matches CORE). Other creators unchanged.
# Leave either empty to disable.
# JIRA_RELEASE_LINK_FILTER_CREATORS=557058:9ba5f45b-83c6-4d75-bc85-17fc85dcad99,5f7fff326029960076fec9f9,712020:f7f842da-70e2-44f1-9556-1dfa5c50db12,712020:ee1cfe12-2870-4d7d-8d71-3432140ae91c
# JIRA_RELEASE_LINK_FILTER_PROJECTS=LINUX,COR
# Skip when updated-window (from JIRA_JQL updated >= -Nd) has Automation Deployed
# comment but no Saathi release comment. Include when Saathi comment is also in window.
# JIRA_DEPLOYED_AUTOMATION_COMMENT_AUTHOR=Automation for Jira
# JIRA_DEPLOYED_AUTOMATION_COMMENT_PREFIX=Ticket Automation Executed. Your ticket has been marked as
# JIRA_COMMENT_LOOKBACK_DAYS=7
# Prepend header row when tab A1 is empty (default on). Set to 0 to skip.
# GOOGLE_SHEETS_WRITE_HEADERS=1

# daily_task_log.py — local DailyTaskLogs.xlsx (Mon–Fri; Mon = 3-day lookback, Tue–Fri = 1 day)
# DAILY_TASK_LOG_WORKBOOK=/home/you/jira-sheet-sync/DailyTaskLogs.xlsx
# Only COR/LINUX transitions performed by the JIRA_API_TOKEN user (default on). Set 0 to include all.
# DAILY_TASK_LOG_ONLY_MY_TRANSITIONS=1
# DEVOPS JQL for daily_task_log.py only (updated >= -Nd is replaced at runtime: Mon=3, Tue–Fri=1)
# DAILY_TASK_LOG_JQL=project = DEVOPS AND updated >= -1d AND issuetype = Release ORDER BY updated DESC
# DEVOPS QA gate statuses (comma-separated "to" values)
# DAILY_TASK_LOG_QA_FROM_STATUS=Deployed on dev-int
# DAILY_TASK_LOG_QA_TO_STATUSES=Deployed on-FT,QA Signed OFF
# Excel column E when you did not comment and did not perform the QA status move on a DEVOPS ticket
# DAILY_TASK_LOG_QA_MISSING_NOTE=QA done by Peer or\nNo QA done

# --- Google auth (pick ONE) ---

# A) Service account JSON (share the sheet with client_email from that file)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# B) OAuth Desktop client JSON (sign in with YOUR Google account in the browser; no sharing with SA)
# Download from GCP: APIs & Services → Credentials → OAuth client ID → Desktop app
# GOOGLE_OAUTH_CLIENT_SECRETS_FILE=/absolute/path/to/client_secret_....json
# Optional: where to store the refresh token after first login
# GOOGLE_OAUTH_TOKEN_FILE=/absolute/path/.google-sheets-token.json

# release_mail_draft.py — Gmail draft (enable Gmail API in GCP; separate token file)
# GOOGLE_GMAIL_TOKEN_FILE=/absolute/path/.gmail-token.json
# RELEASE_MAIL_TYPE=Web
# RELEASE_MAIL_KIND=New Release
# Signature is loaded from Gmail Settings (send-as). Fallback if empty:
# MAIL_SIGNATURE_NAME=Akhil Agarwal | SDET-2
# MAIL_SIGNATURE_PHONE=9717724148

